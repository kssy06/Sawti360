# Sawti 360 · variables d'environnement (noms seulement, jamais de valeurs dans le dépôt).
# En local : copier ce fichier en .env.local (ignoré par git) et le remplir.
# En production : Vercel → Settings → Environment Variables (Production et Preview).
# Détail de chaque variable : docs/backend/SETUP.md § 5.

# ---- Navigateur (publiques par nature : aucun secret ici)
# 1 = back-end réel ; 0 ou absent = interface entièrement simulée, comme avant le back-end.
VITE_BACKEND=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SAWTI_PUBLIC_KEY=

# ---- Serveur
APP_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=
# npx tsx scripts/keys.ts (64 caractères hexadécimaux)
SAWTI_SIGNING_SEED=

# ---- IA
GROQ_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optionnel : relecture LLM 2 par Claude
ANTHROPIC_API_KEY=
# Optionnels (défauts : docs/backend/IA.md § 1)
GROQ_ASR_MODEL=
GROQ_LLM_MODEL=
GEMINI_MODEL=
# Modèle Gemini utilisé hors production (Flash-Lite : quotas gratuits plus larges)
GEMINI_MODEL_DEV=
GEMINI_ASR_MODEL=
CLAUDE_MODEL=
TTS_MODEL=
# 1 = audio de test silencieux et signalé (développement, sans crédits ElevenLabs)
SAWTI_TTS_MOCK=

# ---- E-mails (Gmail SMTP, mot de passe d'application)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Démonstration
# nour=<e-mail>,lina=<e-mail> : seuls comptes ouvrables par POST /api/demo/session
DEMO_EMAILS=
# Mot de passe des comptes de démo, utilisé par npm run seed
DEMO_PASSWORD=
